APP_ENV=development
AUTH_KEY_FILE=.local/auth.key
# Trust only actual reverse-proxy networks; keep empty for direct local access.
TRUSTED_PROXY_CIDRS=
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://lottery:lottery_local@127.0.0.1:5432/lottery?sslmode=disable
DATABASE_READ_URLS=[]
# Legacy single-replica alternative: DATABASE_READ_URL=postgres://...
REDIS_URL=redis://127.0.0.1:6379/0
NATS_URL=nats://127.0.0.1:4222
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=lottery-local
OBJECT_STORAGE_ACCESS_KEY=lottery_local
OBJECT_STORAGE_SECRET_KEY=lottery_local_storage
DB_MAX_CONNS=20
LOG_LEVEL=info
# Set only when running PostgreSQL integration tests against an isolated database.
TEST_DATABASE_URL=

# All operational listeners and outbound traces are disabled by default.
# Use separate literal loopback API/worker ports; non-loopback binds are rejected.
# Never proxy these under public /api.
API_METRICS_ADDR=
WORKER_METRICS_ADDR=
# Required for either listener: a private regular file (0400/0600), generated
# separately with platform generate-metrics-token; do not reuse AUTH_KEY_FILE.
METRICS_TOKEN_FILE=
# Explicit HTTPS OTLP HTTP collector; HTTP is only allowed on literal loopback.
TRACE_OTLP_ENDPOINT=
TRACE_SAMPLE_RATIO=0.1
