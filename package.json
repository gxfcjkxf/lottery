{
  "name": "lottery-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:user": "pnpm --filter @lottery/user-web dev",
    "dev:admin": "pnpm --filter @lottery/admin-web dev",
    "dev:platform": "pnpm --filter @lottery/platform-web dev",
    "review:user": "pnpm --filter @lottery/user-web exec vite --config vite.review.config.ts",
    "review:admin": "pnpm --filter @lottery/admin-web exec vite --config vite.review.config.ts",
    "review:platform": "pnpm --filter @lottery/platform-web exec vite --config vite.review.config.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:static",
    "test:static": "node --test tests/static/*.test.mjs",
    "api:generate": "node scripts/build-openapi.mjs",
    "api:check": "node scripts/build-openapi.mjs --check && redocly lint --extends spec docs/openapi.json",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:capacity-report": "node scripts/check-capacity-baseline.mjs",
    "test:capacity-safety": "node scripts/check-capacity-safety.mjs",
    "test:capacity-settlement": "node scripts/check-capacity-settlement.mjs",
    "test:capacity-withdrawals": "node scripts/check-capacity-withdrawals.mjs",
    "test:capacity-commission": "node scripts/check-capacity-commission.mjs",
    "test:capacity-mixed-models": "node scripts/check-capacity-mixed-models.mjs",
    "test:e2e": "playwright test",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "test:responsive": "playwright test --config playwright.responsive.config.ts",
    "test:commission-responsive": "node scripts/run-commission-responsive.mjs",
    "test:pwa": "pnpm build && playwright test --config playwright.pwa.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@redocly/cli": "^2.57.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
